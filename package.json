{
  "name": "vdoc-app",
  "version": "1.0.0",
  "private": true,
  "description": "macOS GUI over the vdoc CLI for the Vosker-doc repository",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run typecheck && node --experimental-strip-types --test src/shared/__tests__/*.test.ts",
    "pack": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "productName": "V-DOC",
  "author": "Nerwin",
  "build": {
    "appId": "dev.nerwin.vdoc",
    "productName": "V-DOC",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "icon.png"
    ],
    "mac": {
      "target": "dir",
      "identity": null,
      "icon": "icon.png",
      "category": "public.app-category.developer-tools"
    }
  }
}
