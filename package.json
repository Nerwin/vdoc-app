{
  "name": "vdoc-app",
  "version": "1.14.0",
  "private": true,
  "description": "App GUI over the vdoc CLI",
  "main": "out/main/index.js",
  "productName": "V-DOC",
  "author": {
    "name": "Nerwin",
    "email": "7089842+Nerwin@users.noreply.github.com"
  },
  "homepage": "https://github.com/Nerwin/vdoc-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nerwin/vdoc-app.git"
  },
  "vdocCli": {
    "minimumVersion": "1.7.0",
    "updateCommand": "bun install -g @vosker/vdoc@latest",
    "downloadUrl": "https://bitbucket.org/spypoint/vdoc/downloads/"
  },
  "overrides": {
    "dompurify": "3.4.13"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "check:bundle": "node scripts/check-renderer-bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run typecheck && npm run knip && node --experimental-strip-types --test src/shared/__tests__/*.test.ts",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "release": "commit-and-tag-version",
    "knip": "knip"
  },
  "dependencies": {
    "@sentry/electron": "^7.17.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "commit-and-tag-version": "^13.1.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "knip": "^6.32.2",
    "marked": "^18.0.11",
    "mermaid": "^11.17.1",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "dev.nerwin.vdoc",
    "productName": "V-DOC",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**"
    ],
    "electronLanguages": [
      "en"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Nerwin",
        "repo": "vdoc-app"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "notarize": false,
      "category": "public.app-category.developer-tools"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "synopsis": "GUI over the vdoc CLI"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    }
  }
}
